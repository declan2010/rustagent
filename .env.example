# OpenAI-compatible Chat Completions endpoint
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=llama.cpp
OPENAI_MODEL=llama.cpp
OPENAI_INPUT=text,image
OPENAI_CONTEXT_WINDOW=262144
# Request timeout in milliseconds (0 = disabled).
OPENAI_TIMEOUT_MS=0
# Enables Ollama's native /api/chat (the only channel that understands "think").
# Values: false, true, low, medium, high, xhigh, max (aliases: off, on, no, yes).
# OPENAI_OLLAMA_THINK=low

# Permission modes: auto, ask, or off. Defaults: terminal ask, skills/MCP off.
TERMINAL_MODE=off
SKILLS_MODE=off
MCP_MODE=off
